# --- Supabase Postgres (server-side only; never exposed to the browser)
# Runtime: the Transaction pooler string (port 6543) from Supabase → Connect.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# Migrations: the Session pooler or direct string (port 5432).
MIGRATE_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# --- Clerk (staff sign-in, one account per device is fine)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Only these email domains may use the app (comma separated)
ALLOWED_EMAIL_DOMAINS=prologuebooks.co.uk

# --- Staff PIN switching: signs the "who's serving" cookie. 32+ random characters.
SESSION_SECRET=

# --- Chargebee webhook (Basic auth set on the webhook in Chargebee)
CHARGEBEE_WEBHOOK_USER=
CHARGEBEE_WEBHOOK_PASSWORD=
# Optional: plan / item price IDs that mean Founding tier (also matched by "founding" in the ID)
CHARGEBEE_FOUNDING_PLAN_IDS=
# Optional: only these plans are Society memberships (blank = all)
CHARGEBEE_SOCIETY_PLAN_IDS=
# Days of benefits after a failed payment (or until Chargebee's next retry, if later)
GRACE_DAYS=14

# --- Typeform reading preferences webhook secret
TYPEFORM_WEBHOOK_SECRET=

# --- Vercel cron (scan log retention)
CRON_SECRET=

# --- Customer screen "Not a member yet?" QR
NEXT_PUBLIC_JOIN_URL=https://prologuebooks.co.uk/society

# --- Local development only: skip Clerk entirely
# DEV_NO_AUTH=1
